# Optional: enables "Sync with Google Drive" in the app.
# Create an OAuth client ID (see README → Cross-device sync) and paste it here,
# then copy this file to `.env`. Leave unset to keep sync hidden — the app works
# fully without it (local + offline). This value is a public browser client ID,
# not a secret.
VITE_GOOGLE_CLIENT_ID=

# Optional: where in-app feedback is delivered. Paste the /exec URL of a Google
# Apps Script web app that appends a row to a Sheet (see docs/feedback-setup.md).
# Leave unset and feedback is queued locally until an endpoint is configured.
VITE_FEEDBACK_URL=

# Optional: a shared image-import reader so screenshots work WITHOUT each user
# bringing their own Claude key. Paste the URL of the Cloudflare Worker proxy in
# worker/ (see docs/shared-key-setup.md). Leave unset and screenshot import uses
# the user's own key if set, else on-device OCR. Spend is hard-capped Anthropic-
# side (prepaid credits + a workspace limit), NOT by this app.
VITE_IMAGE_PROXY_URL=
